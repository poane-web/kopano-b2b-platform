# Kopano environment example — copy to .env (never commit real secrets)

# --- Required (production fail-fast) ---
NODE_ENV=development
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
DATABASE_URL=postgres://kopano:change-me-strong-password@localhost:5432/kopano

# --- Required database (if DATABASE_URL not used) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kopano
DB_USER=kopano
DB_PASSWORD=change-me-strong-password

# --- API / frontend ---
PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Optional ---
JWT_REFRESH_SECRET=
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
PAYMENT_RATE_LIMIT_MAX=30
BCRYPT_ROUNDS=12
PLATFORM_FEE_BPS=300
MAX_ORDER_QTY=100
UPLOAD_MAX_BYTES=1048576
DB_SSL=false

# Optional: real PostgreSQL for `npm run test:pg`
# TEST_DATABASE_URL=postgres://kopano:change-me-strong-password@localhost:5432/kopano

# --- Payments ---
# Payments stay awaiting_confirmation until a verified provider notification arrives.
# Orange Money WebPay authenticates callbacks via notif_token (not HMAC).
# Set OM_REQUIRE_HMAC=true only for signed test adapters / reverse-proxy signing.
OM_MERCHANT_ID=
OM_MERCHANT_KEY=
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_WEBHOOK_SECRET=
OM_REQUIRE_HMAC=false
OM_ENV=sandbox
OM_API_URL=
PAYMENT_SANDBOX_AUTO_COMPLETE=false
PAYMENT_RESERVATION_TTL_MINUTES=20
PAYMENT_RETURN_URL=http://localhost:5173/success
PAYMENT_ALLOW_UNCONFIGURED=false
DPO_COMPANY_TOKEN=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=kopano-documents
AWS_REGION=af-south-1
